#!/bin/sh

if [ -n "$DEBUG" ]; then
    set -x
fi

if ! find . -mindepth 1 | read -r; then
    >&2 echo "Creating default configs..."
    cp -r /opt/cfx-server-data/* /config
    RCON_PASS="${RCON_PASSWORD-$(tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 16)}"
    sed -i "s/{RCON_PASS}/${RCON_PASS}/g" /config/server.cfg;
    >&2 echo "----------------------------------------------"
    >&2 echo "RCON password is set to: ${RCON_PASS}"
    >&2 echo "----------------------------------------------"
fi

if [ -n "$NO_ONESYNC" ]; then
    >&2 printf "NO_ONESYNC has been removed, as Onesync is now the default for FiveM. Please use 'set onesync off' in your server config if you require this option.\n\n"
    exit 1
fi

# These two arguments do the same thing - just set one to the other!
if [ -n "$ENABLE_TXADMIN" ]; then
  NO_DEFAULT_CONFIG="$ENABLE_TXADMIN"
fi

CONFIG_ARGS=
if [ -z "${NO_DEFAULT_CONFIG}" ]; then
    CONFIG_ARGS="$CONFIG_ARGS +exec /config/server.cfg"
fi

# English is hard
if [ -z "${NO_LICENSE_KEY}${NO_LICENCE_KEY}" ]; then
    if [ -z "${LICENSE_KEY}" ] && [ -n "${LICENCE_KEY}" ]; then
        LICENSE_KEY="${LICENCE_KEY}"
    fi

    if [ -z "${NO_DEFAULT_CONFIG}" ] && [ -z "${LICENSE_KEY}" ]; then
        >&2 printf "License key not found in environment, please create one at https://portal.cfx.re/servers/registration-keys!\n"
        exit 1
    fi

    if [ -z "${CONFIG_ARGS}" ] && [ -n "${LICENSE_KEY}" ] && [ -n "${NO_DEFAULT_CONFIG}" ]; then
        >&2 printf "txadmin does not use the \$LICENSE_KEY environment variable.\nPlease remove it and set it through the txadmin web UI\n\n"
        exit 1
    fi

    CONFIG_ARGS="$CONFIG_ARGS +set sv_licenseKey ${LICENSE_KEY}"
fi

if [ "$(uname -m)" = "aarch64" ]; then
    FEX_EMU_CMD="$(command -v "fex-starter.sh" 2>/dev/null || true)"
    [ -z "$FEX_EMU_CMD" ] && >&2 echo "FEX is not installed, but is required for ARM64. Please install it." && exit 1

    if [ "$(cat /proc/sys/vm/overcommit_memory)" != "1" ]; then
        if sysctl vm.overcommit_memory=1 >/dev/null 2>&1; then
            if [ "$(cat /proc/sys/vm/overcommit_memory)" = "1" ]; then
                >&2 echo "Enabled overcommit_memory for FEX"
            else
                >&2 echo "Set to enable overcommit_memory for FEX was not working, this may cause issues."
            fi
        else
            >&2 echo "Failed to enable overcommit_memory for FEX, this may cause issues."
        fi
    else
        >&2 echo "overcommit_memory is already enabled for FEX"
    fi
else
    FEX_EMU_CMD=""
fi

if [ "$USE_ENHANCED" = "true" ]; then
CFX_SERVER="/opt/cfx-server-enhanced"
mkdir -p /txData && ln -sfn /txData $CFX_SERVER/txData || true
exec $FEX_EMU_CMD \
    $CFX_SERVER/alpine/lib/ld-musl-x86_64.so.1 \
    --library-path "$CFX_SERVER/alpine/lib/:$CFX_SERVER/alpine/usr/lib/" -- \
    $CFX_SERVER/alpine/opt/cfx-server/cfx-server \
        +set citizen_dir $CFX_SERVER/alpine/opt/cfx-server/citizen/ \
        $CONFIG_ARGS \
        $*
else
CFX_SERVER="/opt/cfx-server"
mkdir -p /txData && ln -sfn /txData $CFX_SERVER/txData || true
exec $FEX_EMU_CMD \
    $CFX_SERVER/alpine/opt/cfx-server/ld-musl-x86_64.so.1 \
    --library-path "$CFX_SERVER/alpine/usr/lib/v8/:$CFX_SERVER/alpine/lib/:$CFX_SERVER/alpine/usr/lib/" \
    -- \
    $CFX_SERVER/alpine/opt/cfx-server/FXServer \
        +set citizen_dir $CFX_SERVER/alpine/opt/cfx-server/citizen/ \
        $CONFIG_ARGS \
        $*
fi
